# LearnHub Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnhub?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL
CLIENT_URL=http://localhost:5173

# LiveKit Video Streaming Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Initial Admin Account Seed Setup (Optional)
ADMIN_NAME=LearnHub Administrator
ADMIN_EMAIL=admin@learnhub.com
ADMIN_PASSWORD=AdminSecurePassword2026!